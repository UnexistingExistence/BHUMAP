generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SURVEYOR
  ADMIN
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  surveyorId  String?
  targetState String?
  role        Role     @default(SURVEYOR)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}